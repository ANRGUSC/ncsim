\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Experiment 2: Effective per-link rate vs.\ separation for two parallel 30\,m links. Below the CS range (71.2\,m), links contend via Bianchi's model. Above it, hidden terminal SINR degradation causes a non-monotonic \emph  {dip}: the rate drops from 3.79 to 3.23\,MB/s at the boundary because uncoordinated simultaneous transmissions degrade SINR more than fair time-sharing reduces throughput. Rate recovers as interference power falls with increasing distance.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:exp2}{{3}{4}{Experiment 2: Effective per-link rate vs.\ separation for two parallel 30\,m links. Below the CS range (71.2\,m), links contend via Bianchi's model. Above it, hidden terminal SINR degradation causes a non-monotonic \emph {dip}: the rate drops from 3.79 to 3.23\,MB/s at the boundary because uncoordinated simultaneous transmissions degrade SINR more than fair time-sharing reduces throughput. Rate recovers as interference power falls with increasing distance}{figure.caption.5}{}}
\newlabel{fig:exp2@cref}{{[figure][3][]3}{[1][4][]4}{}{}{}}
